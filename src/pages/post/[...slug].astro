---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

type Post =
  | CollectionEntry<'blog'>
  | CollectionEntry<'policies'>;

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const policyPosts = await getCollection('policies');

  const posts: Post[] = [...blogPosts, ...policyPosts];

  return posts.map((post) => ({
    params: {
      slug: `${post.collection}/${post.id}`,
    },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);

const { title, date, author, image, attachment } = post.data;

const mediaFiles = import.meta.glob(
  '/src/assets/blog/**/*',
  {
    eager: true,
    query: '?url',
    import: 'default',
  },
);

function getMediaUrl(path?: string) {
  if (!path) return undefined;

  const filename = path.split('/').pop();
  if (!filename) return undefined;

  const match = Object.entries(mediaFiles).find(
    ([filePath]) => filePath.split('/').pop() === filename,
  );

  return match?.[1] as string | undefined;
}

const imageUrl = getMediaUrl(image);
const attachmentUrl = getMediaUrl(attachment);

const pageTitle = `ΕΚΝΕ - ${title}`;
---

<Layout title={pageTitle}>
  <Navbar />

  <main data-level={post.collection === 'blog' ? '1' : '2'}>
    <article id="post-content">
      <h1>{title}</h1>

      <p class="post-meta">
        {author}
        {author && date && ' — '}
        {date.toLocaleDateString('el-GR')}
      </p>

      {imageUrl && (
        <img
          class="post-hero"
          src={imageUrl}
          alt={title}
        />
      )}

      {attachmentUrl && (
        <p class="post-attachment">
          <a href={attachmentUrl} download>
            Download attachment
          </a>
        </p>
      )}

      <div class="post-body">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  #post-content {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 50px 20px;
  }

  #post-content > h1 {
    margin-bottom: 12px;
    color: var(--blue);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
  }

  .post-meta {
    margin-bottom: 30px;
    color: #777;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .post-hero {
    width: 100%;
    max-height: 550px;
    display: block;
    object-fit: cover;
    margin-bottom: 40px;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .post-attachment {
    margin-bottom: 30px;
  }

  .post-attachment a {
    color: var(--light-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body {
    color: #333;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .post-body :global(h2) {
    margin: 45px 0 18px;
    color: var(--blue);
    font-size: 2rem;
    line-height: 1.25;
  }

  .post-body :global(h3) {
    margin: 35px 0 14px;
    color: var(--blue);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .post-body :global(p) {
    margin: 0 0 22px;
  }

  .post-body :global(a) {
    color: var(--light-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: var(--blue);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 30px;
  }

  .post-body :global(li) {
    margin-bottom: 8px;
  }

  .post-body :global(blockquote) {
    margin: 30px 0;
    padding: 20px 25px;
    background: rgba(9, 106, 199, 0.07);
    border-left: 5px solid var(--light-blue);
    border-radius: 0 12px 12px 0;
    color: #444;
    font-style: italic;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border-radius: 14px;
  }

  .post-body :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .post-body :global(code) {
    padding: 2px 6px;
    background: #f1f1f1;
    border-radius: 5px;
    font-size: 0.9em;
  }

  .post-body :global(pre) {
    margin: 30px 0;
    padding: 20px;
    overflow-x: auto;
    background: #1f2937;
    color: #fff;
    border-radius: 12px;
  }

  .post-body :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
  }
</style>