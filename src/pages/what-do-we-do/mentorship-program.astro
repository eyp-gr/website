---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

// ---------------------------------------------------------------------------
// Testimonials — ΣΗΜΕΙΩΣΗ: τα παρακάτω είναι ΕΝΔΕΙΚΤΙΚΑ/placeholder κείμενα,
// όχι πραγματικά αποσπάσματα από μέλη. Αντικαταστήστε με πραγματικά λόγια
// (και πάρτε τη συναίνεσή τους πριν τα δημοσιεύσετε με όνομα/ρόλο).
// ---------------------------------------------------------------------------
const testimonials = [
    {
        quote: 'Μπήκα στο ΕΚΝΕ χωρίς να ξέρω κανέναν. Μέσα σε λίγους μήνες είχα μια ολόκληρη παρέα και έναν μέντορα που με καθοδήγησε σε κάθε βήμα.',
        name: 'Μέλος ΕΚΝΕ',
        role: 'Μαθήτρια Λυκείου, Θεσσαλονίκη',
    },
    {
        quote: 'Ο μέντοράς μου με βοήθησε να καταλάβω πώς λειτουργεί το σωματείο και ποια βήματα έπρεπε να ακολουθήσω για να αναλάβω πρώτο ρόλο σε Σύνοδο.',
        name: 'Μέλος ΕΚΝΕ',
        role: 'Φοιτητής, Αθήνα',
    },
    {
        quote: 'Μετά από δύο χρόνια αδράνειας, το πρόγραμμα mentorship με βοήθησε να ξαναμπώ στο ΕΚΝΕ χωρίς να νιώθω χαμένος.',
        name: 'Μέλος ΕΚΝΕ',
        role: 'Φοιτήτρια, Θεσσαλονίκη',
    },
];

// ---------------------------------------------------------------------------
// Journey timeline — η πορεία από εθελοντή μέχρι ηγετικό ρόλο.
// ---------------------------------------------------------------------------
const journeySteps = [
    {
        title: 'Γίνεσαι Εθελοντής',
        text: 'Κάνεις την πρώτη σου αίτηση και συμμετέχεις σε μια δράση του ΕΚΝΕ, γνωρίζοντας τον οργανισμό και τους ανθρώπους του από κοντά.',
    },
    {
        title: 'Επιλέγεις Ομάδα',
        text: 'Διαλέγεις σε ποια ομάδα θέλεις να δραστηριοποιηθείς: Οργανωτική, Ακαδημαϊκή, Δημοσιογραφική, Ομάδα Αξιολόγησης ή Ομάδα Ασφάλειας.',
    },
    {
        title: 'Αναλαμβάνεις Ρόλο σε Δράση',
        text: 'Συμμετέχεις ενεργά σε συγκεκριμένη δράση με συγκεκριμένο ρόλο μέσα στην ομάδα σου και αποκτάς πρακτική εμπειρία.',
    },
    {
        title: 'Γίνεσαι Υπεύθυνος Ομάδας',
        text: 'Με την εμπειρία που έχεις αποκτήσει, αναλαμβάνεις τον συντονισμό της ομάδας σου σε επόμενες δράσεις.',
    },
    {
        title: 'Εξελίσσεσαι σε Ηγετικό Ρόλο',
        text: 'Από επικεφαλής δράσης μέχρι μέλος του Διοικητικού Συμβουλίου — και επιστρέφεις να καθοδηγήσεις τους επόμενους εθελοντές.',
    },
];
---

<Layout title="ΕΚΝΕ - Mentorship">

    <Navbar />

        <body data-level="2">

            <div class="banner">
                <h1 data-i18n="what_do_we_do.mentorship.title">Πρόγραμμα Mentorship</h1>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-image">
                        <img src="/src/assets/sessions/mentorship.jpg">
                    </div>
                    <div class="section-text">
                        <h2 data-i18n="what_do_we_do.mentorship.sectionTitle">Mentorship Program</h2>
                        <p data-i18n="what_do_we_do.mentorship.introParagraph1">
                            Κάθε νεοεισαχθέν ή παλιό μέλος στο Ευρωπαϊκό Κοινοβούλιο Νέων Ελλάδος (ΕΚΝΕ) καλείται να αντιμετωπίσει ορισμένες αντικειμενικές δυσκολίες όσον αφορά την κατανόηση της λειτουργίας του οργανισμού, την ομαλή ένταξη του σε αυτόν και την εύρεση των κατάλλων “βημάτων” που θα ακολουθήσει στο ταξίδι του σε αυτό.
                        </p>
                        <br><br>
                        <p data-i18n="what_do_we_do.mentorship.introParagraph2">
                            Λύση σε αυτό έρχεται να δώσει το Mentorship Programme του ΕΚΝΕ “Touched by an Angel”, το οποίο συντονίζει η Ομάδα Εργασίας Ανθρώπινων Πόρων (Υπεύθυνη: Μαρία Ερωτοκρίτου, Μέλη: Μελίνα Μαχιμάρη, Λένα Σπανού, Θανάσης Καραγεώργος, Δήμητρα Γαρδίκη, Αναστασία Τζίκα και Αλεξάνδρα Ταμπάκου).                     
                        </p>
                    </div>
                </div>
            </div>

            <div class="content-container">

                <h2 data-i18n="what_do_we_do.mentorship.whoIsItFor">Ποιους αφορά;</h2>
                <p data-i18n="what_do_we_do.mentorship.whoIsItForText">
                    Πρακτικά το πρόγραμμα είναι ανοιχτό προς όλα τα μέλη και φίλους του Ευρωπαϊκού Κοινοβουλίου Νέων Ελλάδος που έχουν ξεκινήσει, θέλουν να ξεκινήσουν το ταξίδι τους σε αυτό και σε μέλη που θέλουν να συνεχίσουν δημιουργικά και παραγωγικά το ταξίδι τους.
                </p>

                <br><br>

                <h2 data-i18n="what_do_we_do.mentorship.aimsTitle">Αναφορικά, το Mentorship Programme αποσκοπεί στην ομαλή ένταξη των:</h2>
                <ul>
                    <li data-i18n="what_do_we_do.mentorship.aim1">Μαθητών/φοιτητών που έχουν ήδη ασχοληθεί με το ΕΚΝΕ στο παρελθόν αλλά δεν συνέχισαν ενεργά το ταξίδι τους,</li>
                    <li data-i18n="what_do_we_do.mentorship.aim2">Μελών και φίλων που θέλουν καθοδήγηση και στα επόμενα βήματα που πρέπει να ακολουθήσουν και να εμβαθύνουν τις γνώσεις σε Διοικητικά θέματα του σωματείου,</li>
                    <li data-i18n="what_do_we_do.mentorship.aim3">Μαθητών/φοιτητών που έμαθαν πρόσφατα για το ΕΚΝΕ και δεν έχουν συμμετάσχει σε Συνέδρια αυτού.</li>
                </ul>

                <br>

            </div>

            <!-- ============== JOURNEY TIMELINE (κάθετο) ============== -->
            <div class="page-section journey-section">
                <div class="content-container">
                    <h2 data-i18n="what_do_we_do.mentorship.journey.title">Το ταξίδι σου στο ΕΚΝΕ</h2>
                    <p class="journey-intro" data-i18n="what_do_we_do.mentorship.journey.intro">
                        Από την πρώτη σου συμμετοχή ως εθελοντής μέχρι την εξέλιξή σου σε ηγετικούς ρόλους — έτσι μοιάζει συνήθως η πορεία ενός μέλους στο ΕΚΝΕ.
                    </p>

                    <div class="journey-timeline" data-journey>
                        <div class="journey-line-track">
                            <div class="journey-line-fill" data-journey-line></div>
                        </div>

                        {journeySteps.map((step, index) => (
                            <div class="journey-step" data-journey-step>
                                <span class="journey-marker">{index + 1}</span>
                                <div class="journey-content">
                                    <h3 data-i18n={`what_do_we_do.mentorship.journey.steps.s${index + 1}.title`}>{step.title}</h3>
                                    <p data-i18n={`what_do_we_do.mentorship.journey.steps.s${index + 1}.text`}>{step.text}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- ============== TESTIMONIALS ============== -->
            <div class="page-section testimonials-section">
                <div class="content-container">
                    <h2 data-i18n="what_do_we_do.mentorship.testimonials.title">Τι λένε τα μέλη μας</h2>
                    <p class="testimonials-intro" data-i18n="what_do_we_do.mentorship.testimonials.intro">
                        Λίγα λόγια από μέλη που πέρασαν μέσα από το Mentorship Programme.
                    </p>

                    <div class="testimonials-grid">
                        {testimonials.map((t, index) => (
                            <blockquote class="testimonial-card">
                                <p class="testimonial-quote" data-i18n={`what_do_we_do.mentorship.testimonials.items.t${index + 1}.quote`}>{t.quote}</p>
                                <footer class="testimonial-author">
                                    <span class="testimonial-name" data-i18n={`what_do_we_do.mentorship.testimonials.items.t${index + 1}.name`}>{t.name}</span>
                                    <span class="testimonial-role" data-i18n={`what_do_we_do.mentorship.testimonials.items.t${index + 1}.role`}>{t.role}</span>
                                </footer>
                            </blockquote>
                        ))}
                    </div>
                </div>
            </div>

        </body>

    <Footer />
</Layout>

<script>
    const journey = document.querySelector('[data-journey]') as HTMLElement | null;
    const journeyLine = document.querySelector('[data-journey-line]') as HTMLElement | null;

    function updateJourneyProgress() {
        if (!journey || !journeyLine) return;
        const rect = journey.getBoundingClientRect();
        const viewportMiddle = window.innerHeight / 2;
        const progress = (viewportMiddle - rect.top) / rect.height;
        journeyLine.style.transform = `scaleY(${Math.min(Math.max(progress, 0), 1)})`;
    }

    window.addEventListener('scroll', updateJourneyProgress, { passive: true });
    window.addEventListener('resize', updateJourneyProgress);
    updateJourneyProgress();

    const stepObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    stepObserver.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.3 }
    );

    document.querySelectorAll('[data-journey-step]').forEach((step) => stepObserver.observe(step));
</script>

<style>

:root {
  --ekne-navy: #0f2a52;
  --ekne-blue: #1f4fa3;
  --ekne-blue-soft: #e8eefb;
  --ekne-gold: #f2b134;
  --ekne-ink: #1a1c22;
  --ekne-muted: #5c6470;
  --ekne-paper: #ffffff;
  --ekne-line: #dde3ec;
  --ekne-radius: 14px;
}

.testimonials-section {
  padding-block: 4rem 5rem;
  background: linear-gradient(135deg, var(--ekne-blue-soft) 0%, #ffffff 65%);
}

.testimonials-section h2 {
  text-align: center;
  margin-bottom: 0.5rem;
}

.testimonials-intro {
  max-width: 600px;
  margin: 0 auto 2.5rem;
  text-align: center;
  color: var(--ekne-muted);
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.75rem;
}

.testimonial-card {
  margin: 0;
  padding: 1.85rem 1.75rem;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: var(--ekne-radius);
  box-shadow: 0 10px 30px rgba(15, 42, 82, 0.08);
}

.testimonial-quote {
  margin: 0 0 1.25rem;
  font-size: 1.02rem;
  line-height: 1.65;
  color: var(--ekne-ink);
  font-style: italic;
}

.testimonial-author {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.testimonial-name {
  font-weight: 700;
  color: var(--ekne-navy);
  font-style: normal;
}

.testimonial-role {
  font-size: 0.85rem;
  color: var(--ekne-muted);
}

/* =========================================================================
   6. JOURNEY TIMELINE — κάθετο, γεμίζει καθώς σκρολάρεις (σελίδα "Mentorship")
   ========================================================================= */

.journey-section {
  padding-block: 1rem 5rem;
}

.journey-section h2 {
  text-align: center;
  margin-bottom: 0.5rem;
}

.journey-intro {
  max-width: 600px;
  margin: 0 auto 3rem;
  text-align: center;
  color: var(--ekne-muted);
}

.journey-timeline {
  position: relative;
  max-width: 700px;
  margin: 0 auto;
  padding-left: 2.75rem;
}

.journey-line-track {
  position: absolute;
  left: 13px;
  top: 6px;
  bottom: 6px;
  width: 3px;
  background: var(--ekne-line);
  border-radius: 2px;
}

.journey-line-fill {
  position: absolute;
  inset: 0;
  background: var(--ekne-blue);
  border-radius: 2px;
  transform: scaleY(0);
  transform-origin: top;
}

.journey-step {
  position: relative;
  padding-bottom: 2.75rem;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.journey-step.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.journey-step:last-child {
  padding-bottom: 0;
}

.journey-marker {
  position: absolute;
  left: -2.75rem;
  top: 0;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--ekne-paper);
  border: 3px solid var(--ekne-blue);
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--ekne-blue);
}

.journey-content h3 {
  margin: 0 0 0.4rem;
  font-size: 1.1rem;
}

.journey-content p {
  margin: 0;
  color: var(--ekne-muted);
  line-height: 1.55;
}

@media (prefers-reduced-motion: reduce) {
  .journey-step {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
</style>