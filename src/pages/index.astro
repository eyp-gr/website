---
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout>

    <Navbar />

    <main>

        <!-- HERO -->
        <div class="hero">

            <img
                src="/src/assets/index.webp"
                alt="Η 51η Εθνική Συνδιάσκεψη Επιλογής"
                fetchpriority="high"
                decoding="async"
            >

            <div class="hero-overlay">

                <h1 data-i18n="home.heroTitle">
                    Ευρωπαϊκό Κοινοβούλιο Νέων Ελλάδος
                </h1>

                <p data-i18n="home.heroSubtitle">
                    Η νέα γενιά της Ευρώπης είναι εδώ!
                </p>

                <div class="button-group">

                    <a
                        href="/get-to-know-us/who-we-are"
                        class="pill-btn"
                        data-i18n="home.learnMore"
                    >
                        Μάθετε περισσότερα
                    </a>

                    <a
                        href="#events"
                        class="pill-btn"
                        data-i18n="home.upcomingEvents"
                    >
                        Επερχόμενες δράσεις
                    </a>

                </div>

            </div>
        </div>


        <!-- ABOUT EYP -->
        <div class="page-section eyp-intro">

            <div class="content-container section-grid">

                <div class="section-text eyp-section">

                    <h2 data-i18n="home.aboutTitle">
                        Τι είναι το Ευρωπαϊκό Κοινοβούλιο Νέων;
                    </h2>

                    <p data-i18n="home.aboutText">
                        Το Ευρωπαϊκό Κοινοβούλιο Νέων Ελλάδος είναι η Εθνική
                        Επιτροπή του Ευρωπαϊκού Κοινοβουλίου Νέων (ΕΚΝ) στην
                        Ελλάδα. Το ΕΚΝ είναι ένας μη κυβερνητικός,
                        μη κερδοσκοπικός οργανισμός που διοργανώνει συνέδρια
                        για νέους, προσομοιώνοντας τη λειτουργία του
                        Ευρωπαϊκού Κοινοβουλίου.
                    </p>

                </div>

                <div class="eyp-video">

                    <iframe
                        width="560"
                        height="315"
                        src="https://www.youtube.com/embed/LVJfU0-HZaE?si=8AL3f9KeV5lvcyDQ"
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    ></iframe>

                </div>

            </div>
        </div>


        <!-- EVENTS -->
        <div class="events" id="events">

            <div class="content-container">

                <div class="section-header">

                    <h2 data-i18n="home.eventsTitle">
                        Επερχόμενες δράσεις
                    </h2>

                </div>


                <div class="event-grid">


                    <!-- RSC -->
                    <div class="event-card">

                        <img
                            src="/src/assets/sessions/2nd-RSC-full.png"
                            alt="Patras '26"
                            loading="lazy"
                        >

                        <div class="event-content">

                            <span
                                class="event-date"
                                data-i18n="home.events.rsc.date"
                            >
                                5-8 Νοεμβρίου 2026
                            </span>

                            <h3 data-i18n="home.events.rsc.title">
                                2η Περιφερειακή Συνδιάσκεψη Επιλογής
                            </h3>

                            <p
                                class="event-location"
                                data-i18n="home.events.rsc.location"
                            >
                                Πάτρα
                            </p>

                        </div>

                    </div>


                    <!-- UF -->
                    <div class="event-card">

                        <img
                            src="/src/assets/sessions/2nd-UF-full.png"
                            alt="2nd UF"
                            loading="lazy"
                        >

                        <div class="event-content">

                            <span
                                class="event-date"
                                data-i18n="home.events.uf.date"
                            >
                                26-29 Νοεμβρίου 2026
                            </span>

                            <h3 data-i18n="home.events.uf.title">
                                2ο Πανεπιστημιακό Φόρουμ
                            </h3>

                            <p
                                class="event-location"
                                data-i18n="home.events.uf.location"
                            >
                                Αθήνα
                            </p>

                        </div>

                    </div>


                    <!-- NSC -->
                    <div class="event-card">

                        <img
                            src="/src/assets/sessions/50th-NSC-full.jpg"
                            alt="Thessaloniki '26"
                            loading="lazy"
                            style="transform: scale(1.2);"
                        >

                        <div class="event-content">

                            <span
                                class="event-date"
                                data-i18n="home.events.nsc.date"
                            >
                                10-14 Δεκεμβρίου 2026
                            </span>

                            <h3 data-i18n="home.events.nsc.title">
                                52η Εθνική Συνδιάσκεψη Επιλογής
                            </h3>

                            <p
                                class="event-location"
                                data-i18n="home.events.nsc.location"
                            >
                                Θεσσαλονίκη
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PARTICIPATION -->
        <div class="join-section">

            <div class="content-container">

                <div class="section-header">

                    <h2
                        style="color: #1B365D;"
                        data-i18n="home.participationTitle"
                    >
                        Πώς μπορώ να συμμετάσχω;
                    </h2>

                </div>


                <div class="join-grid">


                    <!-- PARTICIPANTS -->
                    <a
                        href="/participation/participants"
                        class="join-card"
                    >

                        <div class="join-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>

                        <h3 data-i18n="home.participation.participants.title">
                            Σύνεδροι
                        </h3>

                        <p data-i18n="home.participation.participants.description">
                            Παρακολουθήστε μια συνεδρίαση του Ευρωπαϊκού
                            Κοινοβουλίου Νέων ως σύνεδρος
                        </p>

                        <span>
                            <span data-i18n="home.participation.participants.link">
                                Μάθε περισσότερα
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>


                    <!-- VOLUNTEERS -->
                    <a
                        href="/participation/volunteers"
                        class="join-card"
                    >

                        <div class="join-icon">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                        </div>

                        <h3 data-i18n="home.participation.volunteers.title">
                            Εθελοντές
                        </h3>

                        <p data-i18n="home.participation.volunteers.description">
                            Γίνεται εθελοντής και βοηθήστε στην οργάνωση
                            των δράσεων του Ευρωπαϊκού Κοινοβουλίου Νέων
                        </p>

                        <span>
                            <span data-i18n="home.participation.volunteers.link">
                                Μάθε περισσότερα
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>


                    <!-- SCHOOLS -->
                    <a
                        href="/participation/schools"
                        class="join-card"
                    >

                        <div class="join-icon">
                            <i class="fa-solid fa-school"></i>
                        </div>

                        <h3 data-i18n="home.participation.schools.title">
                            Σχολεία
                        </h3>

                        <p data-i18n="home.participation.schools.description">
                            Δηλώστε συμμετοχή σε δράση μας ως σχολείο
                        </p>

                        <span>
                            <span data-i18n="home.participation.schools.link">
                                Μάθε περισσότερα
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>


                    <!-- PARTNERS -->
                    <a
                        href="/partners/become-a-partner"
                        class="join-card"
                    >

                        <div class="join-icon">
                            <i class="fa-solid fa-handshake"></i>
                        </div>

                        <h3 data-i18n="home.participation.partners.title">
                            Συνεργάτες
                        </h3>

                        <p data-i18n="home.participation.partners.description">
                            Υποστηρίξτε το έργο μας μέσα από συνεργασίες
                        </p>

                        <span>
                            <span data-i18n="home.participation.partners.link">
                                Μάθε περισσότερα
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>


                    <!-- CONTACT -->
                    <a
                        href="/contact"
                        class="join-card"
                    >

                        <div class="join-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>

                        <h3 data-i18n="home.participation.contact.title">
                            Επικοινωνία
                        </h3>

                        <p data-i18n="home.participation.contact.description">
                            Έχετε κάποια ερώτηση; Επικοινωνήστε μαζί μας!
                        </p>

                        <span>
                            <span data-i18n="home.participation.contact.link">
                                Επικοινωνία
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>


                </div>

            </div>

        </div>

    </main>

    <Footer />

</Layout>