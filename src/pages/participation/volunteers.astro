---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

// ---------------------------------------------------------------------------
// Ομάδες λειτουργικών στελεχών. Κράτησα τα ίδια data-i18n keys με πριν ώστε
// να μη χαθούν υπάρχουσες μεταφράσεις — απλώς άλλαξε η παρουσίαση.
// Πρόσθεσα μία 6η κάρτα (Προεδρείο Συνεδρίου / Chairs) ώστε το grid να
// βγαίνει ακριβώς 3x2 όπως ζήτησες· αν δεν τη θέλετε ξεχωριστά από την
// Ακαδημαϊκή Ομάδα, πείτε μου το και τη διαγράφω.
// ---------------------------------------------------------------------------
const teams = [
    {
        id: 'academic',
        img: '/src/assets/photos/image13.webp',
        titleEl: 'Ακαδημαϊκή Ομάδα',
        titleEn: 'Academic Team',
        text: 'Αποτελείται από τον Πρόεδρο, τους Αντιπροέδρους της Συνδυάσκεψης, και τους Υπεύθυνους των Επιτροπών. Το σύνολο της Ακαδημαϊκής Ομάδας είναι υπεύθυνο για την καθοδήγηση των συνέδρων στην συγγραφή των ψηφισμάτων και την ομαλή διεξαγωγή της Γενικής Ολομέλειας της δράσης.',
    },
    {
        id: 'media',
        img: '/src/assets/photos/image9.webp',
        titleEl: 'Δημοσιογραφική Ομάδα',
        titleEn: 'Media Team',
        text: 'Αποτελείται από τον Αρχισυντάκτη, τον Βοηθό Αρχισυντάκτη και τα μέλη της Δημοσιογραφικής Ομάδας. Η Δημοσιογραφική Ομάδα είναι υπεύθυνη για την κάλυψη και προβολή της δράσης στα Μέσα Κοινωνικής Δικτύωσης.',
    },
    {
        id: 'organising',
        img: '/src/assets/photos/image16.webp',
        titleEl: 'Οργανωτική Ομάδα',
        titleEn: 'Organising Team',
        text: 'Αποτελείται από τον / τους Επικεφαλείς της Διοργάνωσης, τους Υπεύθυνους Συντονισμού της Οργανωτικής Ομάδας και τα Μέλη της Οργανωτικής Ομάδας. Η Οργανωτική Ομάδα είναι υπεύθυνη για την προετοιμασία και διοργάνωση της δράσης.',
    },
    {
        id: 'jury',
        img: '/src/assets/photos/image14.webp',
        titleEl: 'Ομάδα Αξιολόγησης',
        titleEn: 'Jury Team',
        text: 'Αποτελείται από τον Υπεύθυνο και τα Μέλη της Ομάδας Αξιολόγησης των Συνέδρων. Η Ομάδα αυτή είναι υπεύθυνη για την αξιολόγηση των συμμετεχόντων και τη σύνταξη της λίστας των Συνέδρων που θα στελεχώσουν αποστολές σε Διεθνείς Συνδυάσκεψεις και άλλες δράσεις.',
    },
    {
        id: 'safety',
        img: '/src/assets/photos/image15.webp',
        titleEl: 'Ομάδα Ασφαλείας',
        titleEn: 'Safety Team',
        text: 'Αποτελείται από τον Event Safe Person και τον National Safety Person και έχει ως σκοπό τη διαφύλαξη της ασφάλειας της δράσης και της ευημερίας των συμμετεχόντων της.',
    },
    {
        id: 'chairs',
        img: '/src/assets/photos/image13.webp',
        titleEl: 'Εκπρόσωποι Σωματείου',
        titleEn: 'NC Representatives',
        text: 'Οι Υπεύθυνοι Επιτροπών (Chairs) καθοδηγούν μία ομάδα συνέδρων κατά τη διάρκεια της δράσης, συντονίζουν τη συζήτηση στην επιτροπή τους και τους προετοιμάζουν για τη Γενική Ολομέλεια.',
    },
];
---

<Layout title="ΕΚΝΕ - Εθελοντές">

    <Navbar />

        <body data-level="2">

            <div class="banner">
                <h1 data-i18n="participation.volunteers.banner_title">Εθελοντές</h1>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-image" style="background-color: #fff;">
                        <img src="/src/assets/photos/image11.webp">
                    </div>
                    <div class="section-text">
                        <h2 data-i18n="participation.volunteers.section_title">Ομάδες λειτουργικών στελεχών</h2>
                        <p data-i18n="participation.volunteers.section_text">
                            Ανακαλύψτε τις ομάδες που μπορείτε να συμμετάσχετε ως λειτουργικό στέλεχος σε δράσεις του ΕΚΝ σε όλη την Ευρώπη!
                        </p>
                        <div class="button-group">
                            <a href="https://members.eyp.org/" class="pill-btn" data-i18n="participation.volunteers.btn_members_platform">Members Platform</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============== ΟΜΑΔΕΣ — μεγάλες κάρτες, φωτό μέσα στα γράμματα ============== -->
            <div class="card-section">
                <div class="content-container">
                    <div class="team-grid">
                        {teams.map((team) => (
                            <div
                                class="team-card"
                                style={`--team-photo: url('${team.img}')`}
                                tabindex="0"
                                role="button"
                                aria-pressed="false"
                                data-team-card
                            >
                                <div class="team-card-inner">
                                    <div class="team-card-face team-card-front">
                                        <div class="team-card-bg"></div>
                                        <div class="team-card-content">
                                            <h3 class="team-card-title">
                                                <span class="team-card-title-el">{team.titleEl}</span>
                                                <span class="team-card-title-en">{team.titleEn}</span>
                                            </h3>
                                        </div>
                                    </div>
                                    <div class="team-card-face team-card-back">
                                        <p class="team-card-desc" data-i18n={`participation.volunteers.${team.id}_text`}>{team.text}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

        </body>

    <Footer />
</Layout>

<script>
    // --------------------------------------------------------------------
    // Οι κάρτες ανοίγουν με hover (desktop) — για κινητά/touch και για
    // πρόσβαση με πληκτρολόγιο, το click/Enter κάνει toggle στο ίδιο state.
    // --------------------------------------------------------------------
    document.querySelectorAll('[data-team-card]').forEach((card) => {
        card.addEventListener('click', () => {
            const isActive = card.classList.toggle('is-active');
            card.setAttribute('aria-pressed', String(isActive));
        });

        card.addEventListener('keydown', (e: Event) => {
            const key = (e as KeyboardEvent).key;
            if (key === 'Enter' || key === ' ') {
                e.preventDefault();
                (card as HTMLElement).click();
            }
        });
    });
</script>
<style>

/* =========================================================================
   ΕΚΝΕ — VOLUNTEER TEAM CARDS
   ========================================================================= */

:root{
    --blue:#1a4388;
    --dark-blue:#1b365d;
    --purple:#434f98;
    --light-blue:#0c9fda;
    --gold:#d4af37;
    --text:#222;
    --muted:#555;
    --white:#fff;
}


/* =========================================================================
   VOLUNTEER TEAMS
   ========================================================================= */

/*
 * Το global .content-container έχει max-width:1100px.
 * Εδώ το μεγαλώνουμε ώστε οι κάρτες να καταλαμβάνουν αισθητά
 * περισσότερο οριζόντιο χώρο.
 */

.card-section .content-container{
    width:92%;
    max-width:1450px;
    margin-left:auto;
    margin-right:auto;
}

.team-grid{
    width:100%;

    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));

    column-gap:35px;
    row-gap:35px;
}

.team-card{
    position:relative;
    width:100%;
    aspect-ratio:16 / 9;
    cursor:pointer;
    perspective: 1200px;
}

.team-card-inner{
    position:relative;
    width:100%;
    height:100%;
    transform-style:preserve-3d;
    transition:transform .8s cubic-bezier(.4,.2,.2,1);
}

.team-card.is-active .team-card-inner{
    transform:rotateY(180deg);
}

.team-card-face{
    position:absolute;
    inset:0;
    overflow:hidden;
    border-radius:var(--radius);
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
}

.team-card-front{
    position:absolute;
    inset:0;
    z-index:2;
    isolation:isolate;
    background:
        linear-gradient(
            135deg,
            var(--dark-blue) 0%,
            var(--blue) 55%,
            var(--purple) 100%
        );
}

.team-card-bg{
    position:absolute;
    inset:0;

    background-image:var(--team-photo);
    background-size:cover;
    background-position:center center;
    background-repeat:no-repeat;

    opacity:0;
    transform:scale(1.03);
    transition: opacity .55s ease, transform .55s ease;
}

.team-card-front::after{
    content:"";
    position:absolute;
    inset:0;
    z-index:1;
    background:
        linear-gradient(
            135deg,
            rgba(27,54,93,.68),
            rgba(67,79,152,.38),
            rgba(12,159,218,.18)
        );

    opacity:0;
    transition:opacity .55s ease;
}


.team-card:hover .team-card-bg,
.team-card:focus-visible .team-card-bg{
    opacity:1;
    transform:scale(1);
}

.team-card:hover .team-card-front::after,
.team-card:focus-visible .team-card-front::after{
    opacity:1;
}

.team-card-content{
    position:absolute;
    inset:0;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:center;

    padding:40px;
}


.team-card-title{
    position:absolute;
    inset:0;

    width:100%;
    height:100%;

    margin:0;
    padding:0 0%;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    text-align:center;

    font-size:clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight:900;

    letter-spacing:-.025em;
    line-height:1.08;

    /*
     * Ακριβώς ίδιο image positioning με το card.
     */
    background-image:var(--team-photo);
    background-size:cover;
    background-position:center center;
    background-repeat:no-repeat;

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;
    -webkit-text-fill-color:transparent;

    -webkit-text-stroke:2px rgba(212,175,55,.95);

    transition:
        color .45s ease,
        -webkit-text-fill-color .45s ease,
        -webkit-text-stroke-color .45s ease;
}


/* =========================================================================
   GREEK TITLE
   ========================================================================= */

.team-card-title-el{
    display:block;

    width:82%;
    max-width:100%;

    margin:0 auto;

    white-space:nowrap;
}


/* =========================================================================
   ENGLISH TITLE
   ========================================================================= */

.team-card-title-en{
    display:block;

    width:82%;
    max-width:100%;

    margin:18px auto 0;

    font-size:.58em;
    font-weight:700;

    letter-spacing:.015em;

    white-space:nowrap;
}


/* =========================================================================
   HOVER TITLE
   ========================================================================= */

.team-card:hover .team-card-title,
.team-card:focus-visible .team-card-title{
    color:var(--white);

    -webkit-text-fill-color:var(--white);

    -webkit-text-stroke:2px var(--gold);
}


/* =========================================================================
   BACK
   ========================================================================= */

.team-card-back{
    transform:rotateY(180deg);

    display:flex;
    align-items:center;
    justify-content:center;

    padding:45px;

    background:
        linear-gradient(
            135deg,
            var(--dark-blue) 0%,
            var(--purple) 100%
        );
}


/* =========================================================================
   GOLD ACCENT
   ========================================================================= */

.team-card-back::before{
    content:"";

    position:absolute;

    top:0;
    left:50%;

    width:90px;
    height:5px;

    transform:translateX(-50%);

    background:var(--gold);

    border-radius:0 0 6px 6px;
}


/* =========================================================================
   BACK TEXT
   ========================================================================= */

.team-card-desc{
    width:88%;
    max-width:760px;

    margin:0;

    color:var(--white);

    font-size:1.08rem;
    line-height:1.7;

    text-align:center;
}


/* =========================================================================
   FOCUS
   ========================================================================= */

.team-card:focus-visible{
    outline:3px solid var(--gold);
    outline-offset:5px;
}


/* =========================================================================
   TABLET
   ========================================================================= */

@media (max-width:1100px){

    .card-section .content-container{
        width:94%;
        max-width:1200px;
    }

    .team-grid{
        column-gap:25px;
        row-gap:25px;
    }

    .team-card-title{
        padding:0 5%;

        font-size:clamp(2rem, 3.8vw, 3rem);
    }

    .team-card-title-el,
    .team-card-title-en{
        width:90%;
    }
}


/* =========================================================================
   MOBILE
   ========================================================================= */

@media (max-width:768px){

    .card-section .content-container{
        width:100%;
        max-width:none;

        padding-left:20px;
        padding-right:20px;
    }

    .team-grid{
        grid-template-columns:1fr;

        gap:25px;
    }

    .team-card{
        aspect-ratio:16 / 10;
    }

    .team-card-title{
        padding:0 5%;

        font-size:clamp(2rem, 8vw, 3rem);
    }

    .team-card-title-el,
    .team-card-title-en{
        width:94%;
        white-space:normal;
    }

    .team-card-title-en{
        margin-top:14px;
    }

    .team-card-content{
        padding:25px;
    }

    .team-card-back{
        padding:30px 25px;
    }

    .team-card-desc{
        width:94%;
        font-size:1rem;
    }
}


/* =========================================================================
   SMALL PHONES
   ========================================================================= */

@media (max-width:480px){

    .team-card{
        aspect-ratio:5 / 4;
    }

    .team-card-title{
        font-size:clamp(1.8rem, 9vw, 2.5rem);
    }

    .team-card-title-en{
        margin-top:12px;
        font-size:.58em;
    }

    .team-card-desc{
        font-size:.95rem;
        line-height:1.6;
    }
}


/* =========================================================================
   REDUCED MOTION
   ========================================================================= */

@media (prefers-reduced-motion:reduce){

    .team-card-inner,
    .team-card-bg,
    .team-card-front::after,
    .team-card-title{
        transition:none !important;
    }
}

</style>