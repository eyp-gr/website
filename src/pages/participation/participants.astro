---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';    
---

<Layout title="ΕΚΝΕ - Συμμετέχοντες">

    <Navbar />

        <body data-level="2">

            <div class="banner">
                <h1 data-i18n="participation.participants.banner_title">Συμμετοχή</h1>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-image" style="background-color: #fff;">
                        <img src="/src/assets/photos/image7.webp">
                    </div>
                    <div class="section-text">
                        <h2 data-i18n="participation.participants.students_title">Μαθητές Λυκείου</h2>
                        <p data-i18n="participation.participants.students_text">
                            Μαθητές λυκείου που ενδιαφέρονται να συμμετέχουν στις δράσεις του Ε.Κ.Ν.Ε., μπορούν να δηλώσουν συμμετοχή ως σύνεδροι (delegates) στις Εθνικές Συνδυασκέψεις Επιλογής σε Αθήνα και Θεσσαλονίκη μέσω του σχολείου και του υπεύθυνου καθηγητή αλλά και συμμετοχή σε άλλες δράσεις (Περιφερειακές Συνδυασκέψεις, Trainings και Μentorship).
                        </p>
                        <div class="button-group">
                            <a href="schools.html" class="pill-btn" data-i18n="participation.participants.btn_schools_info">Πληροφορίες για σχολεία</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-text">
                        <h2 data-i18n="participation.participants.youth_title">Νέοι</h2>
                        <p data-i18n="participation.participants.youth_text">
                            Άτομα άνω των 18 μπορούν να δηλώσουν συμμετοχή ως λειτουργικά στελέχη ή mentees του Mentroship Program δημιουργώντας λογαριασμό στο Members Platform και κάνοντας αίτηση συμμετοχής σε δράσεις σε όλη την Ελλάδα και Ευρώπη.
                        </p>
                        <div class="button-group">
                            <a href="volunteers.html" class="pill-btn" data-i18n="participation.participants.btn_volunteers_positions">Θέσεις λειτουργικών στελεχών</a>
                            <a href="https://members.eyp.org/" class="pill-btn" data-i18n="participation.participants.btn_members_platform">Members Platform</a>
                        </div>
                    </div>
                    <div class="section-image">
                        <img src="/src/assets/photos/image8.webp">
                    </div>
                </div>
            </div>

        </body>

    <Footer />
</Layout>