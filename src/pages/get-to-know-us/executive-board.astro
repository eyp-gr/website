---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';    
---

<Layout>

	<Navbar />

        <body data-level="2">

            <div class="banner">
                <h1 data-i18n="executiveBoard.title">Διοικητικό Συμβούλιο</h1>
            </div>

            <div class="content-container">
                <p class="intro-text" data-i18n="executiveBoard.intro">
                    Το <strong>Διοικητικό Συμβούλιο</strong> του ΕΚΝΕ για το έτος 2026, όπως εκλέχθηκε από τα μέλη του σωματείου, αποτελείται από τους:
                </p>

                <div class="member-grid">

                    <div class="member-card">
                        <div class="image-side">
                            <div class="rotated-bg"></div>
                            <div class="image-box">
                                <img src="/src/assets/board/panos.jpg" alt="Παναγιώτης Τζιάτζιος" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                <div class="image-placeholder" style="display:none;" data-i18n="executiveBoard.members.panos.name">Παναγιώτης Τζιάτζιος</div>
                            </div>
                        </div>
                        <div class="text-side">
                            <div>
                                <h2 class="member-name" data-i18n="executiveBoard.members.panos.name">Παναγιώτης Τζιάτζιος</h2>
                                <p class="member-role" data-i18n="executiveBoard.members.panos.role">Πρόεδρος, Υπεύθυνος Ασφάλειας & Ευημερίας</p>
                            </div>
                            <div class="member-contact">
                                <span class="email-copy" onclick="copyToClipboard('panagiotis.tziatzios@eypgreece.org')">
                                    panagiotis.tziatzios@eypgreece.org
                                </span>
                                <span class="email-copy" onclick="copyToClipboard('president@eypgreece.org')">
                                    president@eypgreece.org
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="member-card">
                        <div class="image-side">
                            <div class="rotated-bg"></div>
                            <div class="image-box">
                                <img src="/src/assets/board/petros.jpg" alt="Πέτρος Κατρακούλης" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                <div class="image-placeholder" style="display:none;" data-i18n="executiveBoard.members.petros.name">Πέτρος Κατρακούλης</div>
                            </div>
                        </div>
                        <div class="text-side">
                            <div>
                                <h2 class="member-name" data-i18n="executiveBoard.members.petros.name">Πέτρος Κατρακούλης</h2>
                                <p class="member-role" data-i18n="executiveBoard.members.petros.role">Αντιπρόεδρος, Υπεύθυνος Δημοσίων Σχέσεων & Στρατηγικής Ανάπτυξης</p>
                            </div>
                            <div class="member-contact">
                                <span class="email-copy" onclick="copyToClipboard('petros.katrakoulis@eypgreece.org')">
                                    petros.katrakoulis@eypgreece.org
                                </span>
                                <span class="email-copy" onclick="copyToClipboard('public.relations@eypgreece.org')">
