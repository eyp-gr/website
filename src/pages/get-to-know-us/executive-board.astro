                                <img src="/src/assets/board/stergiani.jpg" alt="Στεργιανή Τοπαλίδου" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                <div class="image-placeholder" style="display:none;" data-i18n="executiveBoard.members.stergiani.name">Στεργιανή Τοπαλίδου</div>
                            </div>
                        </div>
                        <div class="text-side">
                            <div>
                                <h2 class="member-name" data-i18n="executiveBoard.members.stergiani.name">Στεργιανή Τοπαλίδου</h2>
                                <p class="member-role" data-i18n="executiveBoard.members.stergiani.role">Γενική Γραμματέας, Υπεύθυνη Ανεύρεσης Πόρων</p>
                            </div>
                            <div class="member-contact">
                                <span class="email-copy" onclick="copyToClipboard('stergiani.topalidou@eypgreece.org')">
                                    stergiani.topalidou@eypgreece.org
                                </span>
                                <span class="email-copy" onclick="copyToClipboard('info@eypgreece.org')">
                                    info@eypgreece.org
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="member-card">
                        <div class="image-side">
                            <div class="rotated-bg"></div>
                            <div class="image-box">
