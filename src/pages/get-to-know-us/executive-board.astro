                            </div>
                            <div class="member-contact">
                                <span class="email-copy" onclick="copyToClipboard('iro.michailidi@eypgreece.org')">
                                    iro.michailidi@eypgreece.org
                                </span>
                                <span class="email-copy" onclick="copyToClipboard('international.relations@eypgreece.org')">
                                    international.relations@eypgreece.org
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="member-card full-width-center">
                        <div class="image-side">
                            <div class="rotated-bg"></div>
                            <div class="image-box">
                                <img src="/src/assets/board/ellie.jpg" alt="Ελένη Γκεσούλη" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                <div class="image-placeholder" style="display:none;" data-i18n="executiveBoard.members.ellie.name">Ελένη Γκεσούλη</div>
                            </div>
                        </div>
                        <div class="text-side">
                            <div>
                                <h2 class="member-name" data-i18n="executiveBoard.members.ellie.name">Ελένη Γκεσούλη</h2>
                                <p class="member-role" data-i18n="executiveBoard.members.ellie.role">Μέλος του Δ.Σ., Υπεύθυνη Μάρκετινγκ & Επικοινωνίας</p>
                            </div>
                            <div class="member-contact">
                                <span class="email-copy" onclick="copyToClipboard('eleni.gkesouli@eypgreece.org')">
                                    eleni.gkesouli@eypgreece.org
