                                    alexandros.siomoulis@eypgreece.org
                                </span>
                                <span class="email-copy" onclick="copyToClipboard('treasurer@eypgreece.org')">
                                    treasurer@eypgreece.org
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="member-card">
                        <div class="image-side">
                            <div class="rotated-bg"></div>
                            <div class="image-box">
                                <img src="/src/assets/board/maria.png" alt="Μαρία Ερωτοκρίτου" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                <div class="image-placeholder" style="display:none;" data-i18n="executiveBoard.members.maria.name">Μαρία Ερωτοκρίτου</div>
