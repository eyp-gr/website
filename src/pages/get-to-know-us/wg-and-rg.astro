---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import RegionalPanel from '../../components/RegionalPanel.astro';
import translations from '../../i18n/translations.json';

const t = (key: string): string => {
    const node = key
        .split('.')
        .reduce((obj: any, k) => obj?.[k], translations as any);
    return node?.el ?? key;
};

/* ---------- Ομάδες εργασίας (μόνο χρώματα) ---------- */
const workingGroups = [
    { id: 'secgen', bg: '#1e3a8a', fg: '#ffffff' },
    { id: 'pr', bg: '#2f5aa8', fg: '#ffffff' },
    { id: 'fundraising', bg: '#0f766e', fg: '#ffffff' },
    { id: 'hr', bg: '#3b82f6', fg: '#ffffff' },
    { id: 'international', bg: '#4338ca', fg: '#ffffff' },
    { id: 'marketing', bg: '#f2b134', fg: '#1e3a8a' },
];
---

<Layout title="ΕΚΝΕ - Ομάδες Εργασίας και Περιφερειακές Ομάδες">
    <Navbar />

        <body data-level="2">

            <div class="banner">
                <h1 data-i18n="groups.title">Ομάδες Εργασίας και Περιφερειακές Ομάδες</h1>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-image" style="background-color: #fff;">
                        <img src="/assets/wg-and-rg/wg.webp">
                    </div>
                    <div class="section-text">
                        <h2 data-i18n="groups.workingGroups.title">Ομάδες Εργασίας</h2>
                        <p data-i18n="groups.workingGroups.description">
                            Οι Ομάδες Εργασίας, αποτελούνται από μέλη του Ε.Κ.Ν.Ε. με ενδιαφέρον πάνω στη θεματική της Ομάδας και επιλέγονται, συνήθως μετά από αίτησή τους, από το Μέλος Δ.Σ. που είναι Υπεύθυνο για την Ομάδα.
                        </p>
                    </div>
                </div>
            </div>

            <!-- ΟΜΑΔΕΣ ΕΡΓΑΣΙΑΣ -->
            <div class="content-container">
                <h2 class="wg-heading" data-i18n="executiveBoard.workingGroups.heading">
                    {t('executiveBoard.workingGroups.heading')}
                </h2>

                <div class="wg-grid">
                    {workingGroups.map((wg) => (
                        <div class="wg-tile" style={`background:${wg.bg}; color:${wg.fg};`}>
                            <h3 data-i18n={`executiveBoard.workingGroups.${wg.id}.title`}>
                                {t(`executiveBoard.workingGroups.${wg.id}.title`)}
                            </h3>

                            <p data-i18n={`executiveBoard.workingGroups.${wg.id}.text`}>
                                {t(`executiveBoard.workingGroups.${wg.id}.text`)}
                            </p>
                        </div>
                    ))}
                </div>
            </div>

            <div class="page-section">
                <div class="content-container section-grid">
                    <div class="section-text">
                        <h2 data-i18n="groups.regionalGroups.title">Περιφερειακές Ομάδες</h2>
                        <p data-i18n="groups.regionalGroups.description">
                            Οι Περιφερειακές Ομάδες είναι μια νέα δομή εντός του Ε.Κ.Ν.Ε, η οποία αποσκοπεί στην ενίσχυση της παρουσίας του Σωματείου σε όλη την Ελλάδα. Οι Περιφερειακές Ομάδες αποτελούν τον σύνδεσμο του Ε.Κ.Ν.Ε. με τις τοπικές κοινωνίες της χώρας έτσι ώστε να ενισχύσουμε τη συμμετοχή και την προσβασιμότητα του Σωματείου.
                        </p>
                    </div>
                    <div class="section-image" style="background-color: #fff;">
                        <img src="/assets/wg-and-rg/wg.webp">
                    </div>
                </div>
            </div>

            <div class="content-container">

                <h2 data-i18n="groups.coordinators.title">Περιφερειακοί Συντονιστές</h2>

                <div class="region-panel-list">
                    <RegionalPanel
                        id="north"
                        coordinatorImg="/assets/wg-and-rg/despoina.webp"
                        coordinatorObjectPosition="center 45%"
                        coordinatorLabel="Συντονίστρια Περιφέρειας"
                        coordinatorName="Δέσποινα Παπαδοπούλου"
                        regionName="Βόρεια Ελλάδα"
                        members={[
                            { img: '/assets/wg-and-rg/elena.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Έλενα Αλεξιάδου' },
                            { img: '/assets/wg-and-rg/kyriaki.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Κυριακή Λεπτοκαρίδη' },
                        ]}
                    />

                    <RegionalPanel
                        id="central"
                        coordinatorImg="/assets/wg-and-rg/domniki.webp"
                        coordinatorObjectPosition="center 65%"
                        coordinatorLabel="Συντονίστρια Περιφέρειας"
                        coordinatorName="Δομνίκη Χατζηαλέξη"
                        regionName="Κεντρική Ελλάδα"
                        members={[
                            { img: '/assets/wg-and-rg/apostolos.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Απόστολος Τασούλας' },
                            { img: '/assets/wg-and-rg/marisa.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Μαρίσα Μίγκα' },
                        ]}
                    />

                    <RegionalPanel
                        id="south"
                        coordinatorImg="/assets/wg-and-rg/theophilos.webp"
                        coordinatorObjectPosition="center 65%"
                        coordinatorLabel="Συντονιστής Περιφέρειας"
                        coordinatorName="Θεόφιλος Καραμανώλης"
                        regionName="Νότια Ελλάδα"
                        members={[
                            { img: '/assets/wg-and-rg/asymina.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Ασημίνα Χάνου' },
                            { img: '/assets/wg-and-rg/melina.webp', title: 'Μέλος Περιφερειακής Ομάδας', name: 'Μελίνα Μαχιμάρη' },
                        ]}
                    />
                </div>
            </div>

        </body>

    <Footer />
</Layout>

<style>
.region-panel-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 20px;
}
</style>