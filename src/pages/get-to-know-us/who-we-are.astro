---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

const galleryImages = [
    { src: '/src/assets/photos/image1.webp', alt: 'Στιγμιότυπο από σύνοδο του ΕΚΝΕ' },
    { src: '/src/assets/photos/image21.webp', alt: 'Μέλη του ΕΚΝΕ σε δράση' },
    { src: '/src/assets/photos/image16.webp', alt: 'Ομαδική φωτογραφία εθελοντών' },
    { src: '/src/assets/photos/image11.webp', alt: 'Συζήτηση σε επιτροπή' },
    { src: '/src/assets/photos/image4.webp', alt: 'Εκδήλωση του ΕΚΝΕ' },
];
 
const stats = [
    { key: 'years', target: 32, suffix: '+', label: 'Χρόνια δράσης' },
    { key: 'members', target: 150, suffix: '+', label: 'Ενεργά μέλη' },
    { key: 'events', target: 120, suffix: '+', label: 'Διοργανωμένες δράσεις' },
    { key: 'participants', target: 5000, suffix: '+', label: 'Συμμετέχοντες μαθητές' },
];
---
 
<Layout title="ΕΚΝΕ - Ποιοί είμαστε">
 
	<Navbar />
 
    <body data-level="2">
 
        <div class="banner">
            <h1 data-i18n="whoWeAre.title">Ποιοι Είμαστε</h1>
        </div>
 
        <div class="page-section">
            <div class="content-container section-grid">
                <div class="section-image" style="background-color: #fff;">
                    <img src="/src/assets/who-we-are/image1.webp">
                </div>
                <div class="section-text">
                    <h2 data-i18n="whoWeAre.about.title">Γνωρίστε το Ευρωπαϊκό Κοινοβούλιο Νέων Ελλάδος</h2>
                    <p data-i18n="whoWeAre.about.description">
                        Το Ευρωπαϊκό Κοινοβούλιο Νέων Ελλάδος (Ε.Κ.Ν.Ε.) είναι σωματείο μη κερδοσκοπικού χαρακτήρα και ανεξαρτήτο πολιτικών και κομματικών συμφερόντων. Ιδρύθηκε το 1994 ως μια από τις 40 Εθνικές Επιτροπές του Ευρωπαϊκού Κοινοβουλίου (ΕΚΝ), έχοντας ως μόνιμη έδρα τη Θεσσαλονίκη.
                    </p>
                </div>
            </div>
        </div>
 
        <div class="page-section">
            <div class="content-container section-grid">
                <div class="section-text">
                    <h2 data-i18n="whoWeAre.goals.title">Οι στόχοι μας</h2>
                    <p data-i18n="whoWeAre.goals.description">
                        Κύριοι στόχοι του είναι η προώθηση μιας Ευρωπαϊκής διάστασης στην εκπαίδευση των νέων, η ανάληψη πρωτοβουλιών, καθώς και η ανάπτυξη κοινωνικών και επαγγελματικών δεξιοτήτων.
                    </p>
                </div>
                <div class="section-image">
                    <img src="/src/assets/who-we-are/image2.webp">
                </div>
            </div>
        </div>
 
        <!-- ============== ΓΚΑΛΕΡΙ (μόνο τελίτσες) + ΣΤΑΤΙΣΤΙΚΑ, δίπλα-δίπλα ============== -->
        <div class="page-section gallery-stats-section" data-stats-section>
            <div class="content-container gallery-stats-grid">
 
                <div class="gallery-carousel" data-carousel>
                    <div class="carousel-track-wrapper">
                        <ul class="carousel-track" data-carousel-track>
                            {galleryImages.map((image) => (
                                <li class="carousel-slide">
                                    <img src={image.src} alt={image.alt} loading="lazy" />
                                </li>
                            ))}
                        </ul>
                    </div>
 
                    <div class="carousel-dots" data-carousel-dots role="tablist" aria-label="Επιλογή φωτογραφίας">
                        {galleryImages.map((_, index) => (
                            <button
                                class="carousel-dot"
                                type="button"
                                data-carousel-dot={index}
                                aria-current={index === 0 ? 'true' : 'false'}
                                aria-label={`Φωτογραφία ${index + 1}`}
                            ></button>
                        ))}
                    </div>
                </div>
 
                <div class="stats-grid-2x2">
                    {stats.map((stat) => (
                        <div class="stat-card">
                            <div class="stat-value-row">
                                <span class="stat-number" data-stat-value data-stat-target={stat.target}>0</span>
                                <span class="stat-suffix">{stat.suffix}</span>
                            </div>
                            <p class="stat-label" data-i18n={`whoWeAre.stats.${stat.key}`}>{stat.label}</p>
                        </div>
                    ))}
                </div>
 
            </div>
        </div>
 
    </body>
 
    <Footer />
</Layout>
 
<script>
    // --------------------------------------------------------------------
    // Καρουζέλ: μόνο τελίτσες + αυτόματη εναλλαγή κάθε 5", με παύση στο hover.
    // --------------------------------------------------------------------
    document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const track = carousel.querySelector('[data-carousel-track]') as HTMLElement;
        const slides = Array.from(track?.children ?? []) as HTMLElement[];
        const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]')) as HTMLButtonElement[];
 
        if (!track || slides.length === 0) return;
 
        let index = 0;
        let autoplay: ReturnType<typeof setInterval>;
 
        function goTo(newIndex: number) {
            index = (newIndex + slides.length) % slides.length;
            track.style.transform = `translateX(-${index * 100}%)`;
            dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
        }
 
        function startAutoplay() {
            autoplay = setInterval(() => goTo(index + 1), 5000);
        }
 
        function stopAutoplay() {
            clearInterval(autoplay);
        }
 
        dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); stopAutoplay(); startAutoplay(); }));
 
        carousel.addEventListener('mouseenter', stopAutoplay);
        carousel.addEventListener('mouseleave', startAutoplay);
 
        goTo(0);
        startAutoplay();
    });
 
    // --------------------------------------------------------------------
    // Στατιστικά: μετράνε από το 0 μέχρι το target όταν μπαίνουν στην οθόνη.
    // --------------------------------------------------------------------
    const statsSection = document.querySelector('[data-stats-section]');
 
    function animateValue(el: HTMLElement, target: number) {
        const duration = 1500;
        const start = performance.now();
 
        function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3); // ease-out
            el.textContent = Math.round(eased * target).toLocaleString('el-GR');
            if (progress < 1) requestAnimationFrame(tick);
        }
 
        requestAnimationFrame(tick);
    }
 
    if (statsSection) {
        const observer = new IntersectionObserver(
            (entries, obs) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        statsSection.querySelectorAll('[data-stat-value]').forEach((el) => {
                            const target = Number((el as HTMLElement).dataset.statTarget ?? 0);
                            animateValue(el as HTMLElement, target);
                        });
                        obs.disconnect();
                    }
                });
            },
            { threshold: 0.4 }
        );
        observer.observe(statsSection);
    }
</script>

<style>
  /* =========================================================================
   ΕΚΝΕ — Νέα στοιχεία: gallery/carousel, στατιστικά, ΔΣ hover+grid, timeline
   Import αυτό το αρχείο στις 3 σελίδες. Αν έχετε ήδη CSS variables για τα
   βασικά χρώματα του site, αντικαταστήστε τις τιμές παρακάτω με αυτές ώστε
   να ταιριάζουν με την υπόλοιπη ταυτότητα.
   ========================================================================= */

:root {
  --ekne-navy: #0f2a52;
  --ekne-blue: #1f4fa3;
  --ekne-blue-soft: #e8eefb;
  --ekne-gold: #f2b134;
  --ekne-ink: #1a1c22;
  --ekne-muted: #5c6470;
  --ekne-paper: #ffffff;
  --ekne-line: #dde3ec;
  --ekne-radius: 14px;
}

/* ---------- Γενικά (focus states, reduced motion) ---------- */

.gallery-carousel *:focus-visible,
.board-hover-grid *:focus-visible,
.timeline-scroll *:focus-visible {
  outline: 3px solid var(--ekne-gold);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  .carousel-track,
  .timeline-viewport,
  .image-box img {
    transition: none !important;
    scroll-behavior: auto !important;
  }
}

/* =========================================================================
   1. ΓΚΑΛΕΡΙ + ΣΤΑΤΙΣΤΙΚΑ, δίπλα-δίπλα (σελίδα "Ποιοι Είμαστε")
   ========================================================================= */

.gallery-stats-section {
  padding-block: 2rem 3rem;
}

.gallery-stats-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 6rem;
  align-items: center;
}

/* --- Καρουζέλ: μόνο τελίτσες, χωρίς βελάκια, αυτόματη εναλλαγή --- */

.gallery-carousel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.carousel-track-wrapper {
  overflow: hidden;
  border-radius: var(--ekne-radius);
}

.carousel-track {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
  transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
}

.carousel-slide {
  flex: 0 0 100%;
  aspect-ratio: 4 / 3;
}

.carousel-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  padding: 0;
  background: var(--ekne-line);
  cursor: pointer;
  transition: width 0.3s ease, background 0.3s ease;
}

.carousel-dot[aria-current="true"] {
  width: 22px;
  border-radius: 4px;
  background: var(--ekne-blue);
}

/* --- Στατιστικά: πάντα 2x2, δίπλα στο καρουζέλ --- */

.stats-grid-2x2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 6rem 2rem;
  text-align: center;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2px;
}

.stat-number {
  font-size: clamp(2.1rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--ekne-blue);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-suffix {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--ekne-blue);
}

.stat-label {
  color: var(--ekne-muted);
  font-size: 0.9rem;
  margin: 0;
}

@media (max-width: 860px) {
  .gallery-stats-grid { grid-template-columns: 1fr; }
}
</style>