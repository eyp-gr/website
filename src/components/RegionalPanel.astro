---
export interface Member {
    img: string;
    title: string;
    name: string;
}

export interface Props {
    id: string;
    coordinatorImg: string;
    coordinatorObjectPosition?: string;
    coordinatorName: string;
    coordinatorLabel?: string;
    regionName: string;
    members: Member[];
}

const {
    id,
    coordinatorImg,
    coordinatorObjectPosition = 'center center',
    coordinatorName,
    coordinatorLabel = 'Συντονίστρια/Συντονιστής Περιφέρειας',
    regionName,
    members = []
} = Astro.props;
---

<div class="region-panel">
    <div class="region-coordinator">
        <div class="region-coordinator-image">
            <img
                src={coordinatorImg}
                style={`object-position: ${coordinatorObjectPosition};`}
                alt={coordinatorName}
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="region-image-placeholder" style="display:none;" data-i18n={`groups.coordinators.${id}.name`}>{coordinatorName}</div>
        </div>
        <h3 data-i18n={`groups.coordinators.${id}.name`}>{coordinatorName}</h3>
        <p class="region-coordinator-label" data-i18n="groups.coordinators.label">{coordinatorLabel}</p>
        <p class="region-name" data-i18n={`groups.coordinators.${id}.region`}>{regionName}</p>
    </div>

    <div class="region-divider" aria-hidden="true"></div>

    <div class="region-members">
        {members.map((member, index) => (
            <div class="region-member">
                <div class="region-member-image">
                    <img
                        src={member.img}
                        alt={member.name}
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="region-image-placeholder" style="display:none;" data-i18n={`groups.coordinators.${id}.members.m${index + 1}.name`}>{member.name}</div>
                </div>
                <p class="member-title" data-i18n={`groups.coordinators.${id}.members.m${index + 1}.title`}>{member.title}</p>
                <p class="member-name" data-i18n={`groups.coordinators.${id}.members.m${index + 1}.name`}>{member.name}</p>
            </div>
        ))}
    </div>
</div>

<style>
.region-panel {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 25px 30px;
    background: #dbeafe;
    border-radius: 22px;
}

.region-coordinator {
    flex: 0 0 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.region-coordinator-image {
    position: relative;
    width: 180px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid var(--light-blue);
    border-radius: 18px;
    background: #e2e8f0;
    margin-bottom: 12px;
}

.region-coordinator-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.region-coordinator h3 {
    margin-bottom: 4px;
    color: #1e3a8a;
    font-size: 1.15rem;
    font-weight: 700;
}

.region-coordinator-label {
    color: #64748b;
    font-size: 0.82rem;
    margin-bottom: 2px;
}

.region-name {
    color: #334155;
    font-size: 0.9rem;
    font-weight: 600;
}

.region-divider {
    align-self: stretch;
    width: 1px;
    background: var(--light-blue);
    opacity: 0.35;
}

.region-members {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: flex-start;
}

.region-member {
    flex: 0 1 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.region-member-image {
    position: relative;
    width: 144px;
    height: 172px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid var(--light-blue);
    border-radius: 18px;
    background: #e2e8f0;
    margin-bottom: 8px;
}

.region-member-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.region-member .member-title {
    color: #64748b;
    font-size: 0.78rem;
    margin-bottom: 2px;
}

.region-member .member-name {
    color: #1e3a8a;
    font-size: 0.92rem;
    font-weight: 700;
}

.region-image-placeholder {
    padding: 8px;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    align-items: center;
    justify-content: center;
}

@media (max-width: 720px) {
    .region-panel {
        flex-direction: column;
        align-items: stretch;
    }

    .region-divider {
        width: 100%;
        height: 1px;
    }

    .region-members {
        justify-content: center;
    }
}
</style>